generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
    customer
    shop
    admin
}
enum Status {
    pending
    confirmed
    shipping
    cancelled
}
enum Rating {
    one
    two
    three
    four
    five
}
model User { @@map("users")
    id Int @id @default(autoincrement())
    displayName String @map("display_name")
    email String @unique
    hashedPassword String @map("hashed_password")
    role Role
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    userSession Session[] @relation("UserSession")
    senderNotification Notification[] @relation("SenderNotification") 
    receiverNotification Notification[] @relation("ReceiverNotification") 
    userMessage Message[] @relation("UserMessage")
    shopConversation Conversation[] @relation("ShopConversation")
    customerConversation Conversation[] @relation("CustomerConversation")

    customerOrder Order[] @relation("CustomerOrder")
    shopOrder Order[] @relation("ShopOrder")
    shopProduct Product[] @relation("ShopProduct")
    customerCart Cart? @relation("CustomerCart")
}

model Session { @@map("sessions")
    id Int @id @default(autoincrement())
    userId Int @map("user_id")
    hashedRefreshToken String @unique @map("hashed_refresh_token")
    createdAt DateTime @default(now()) @map("created_at")
    expiredAt DateTime @map("expired_at")

    user User @relation("UserSession",fields: [userId], references: [id])
}

model Notification { @@map("notifications")
    id Int @id @default(autoincrement())
    senderId Int @map("sender_id")
    receivedId Int @map("received_id")
    type String
    title String
    content String
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    sender User @relation("SenderNotification",fields: [senderId], references: [id])
    receiver User @relation("ReceiverNotification",fields: [receivedId], references: [id])
}

model Message { @@map("messages")
    id Int @id @default(autoincrement())
    conversationId Int @map("conversation_id")
    message String
    senderId Int @map("sender_id")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    conversation Conversation @relation("ConversationMessage",fields: [conversationId], references: [id])
    sender User @relation("UserMessage",fields: [senderId], references: [id])
}

model Conversation { @@map("conversations")
    id Int @id @default(autoincrement())
    shopId Int @map("shop_id")
    customerId Int @map("customer_id")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    shop User @relation("ShopConversation",fields: [shopId], references: [id])
    customer User @relation("CustomerConversation",fields: [customerId], references: [id])

    conversationMessage Message[] @relation("ConversationMessage")
}

model Product { @@map("products")
    id Int @id @default(autoincrement())
    shopId Int @map("shop_id")
    SKU String @unique
    brandId Int @map("brand_id")
    categoryId Int @map("category_id")
    name String 
    size String
    quantity Int
    price Int
    description String?
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    shop User @relation("ShopProduct",fields: [shopId], references: [id])
    brand Brand @relation("BrandProduct",fields: [brandId], references: [id])
    category Category @relation("CategoryProduct",fields: [categoryId], references: [id])
    productOrderItem OrderItem[] @relation("ProductOrderItem")
    productCartItem CartItem[] @relation("ProductCartItem")
    productFeedback Feedback[] @relation("ProductFeedback")
}

model Brand { @@map("brands")
    id Int @id @default(autoincrement())
    name String 
    description String?
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    brandProduct Product[] @relation("BrandProduct")
}

model Category { @@map("categories")
    id Int @id @default(autoincrement())
    name String
    description String?
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    categoryProduct Product[] @relation("CategoryProduct")
}

model Order { @@map("orders")
    id Int @id @default(autoincrement())
    customerId Int @map("customer_id")
    shopId Int @map("shop_id")
    status Status 
    price Int
    total Int
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    customer User @relation("CustomerOrder",fields: [customerId], references: [id])
    shop User @relation("ShopOrder",fields: [shopId], references: [id])
    orderOrderItem OrderItem[] @relation("OrderOrderItem")
}
model OrderItem { @@map("order_items")
    id Int @id @default(autoincrement())
    orderId Int @map("order_id")
    productId Int @map("product_id")
    quantity Int
    price Int
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")
    @@unique([orderId, productId])

    order Order @relation("OrderOrderItem",fields: [orderId], references: [id])
    product Product @relation("ProductOrderItem",fields: [productId], references: [id])
}
model Cart { @@map("carts")
    id Int @id @default(autoincrement())
    customerId Int @map("customer_id") @unique
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    customer User @relation("CustomerCart",fields: [customerId], references: [id])
    cartCartItem CartItem[] @relation("CartCartItem")
}
model CartItem { @@map("cart_items")
    id Int @id @default(autoincrement())
    cartId Int @map("cart_id")
    productId Int @map("product_id")
    quantity Int
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")
    @@unique([cartId, productId])

    cart Cart @relation("CartCartItem",fields: [cartId], references: [id])
    product Product @relation("ProductCartItem",fields: [productId], references: [id])
}
model Feedback { @@map("feedbacks")
    id Int @id @default(autoincrement())
    productId Int @map("product_id")
    rating Rating
    feedback String
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    product Product @relation("ProductFeedback",fields: [productId], references: [id])
}